    "@cloudflare/workers-types": "^4.20260702.1",
    "fast-check": "^3.20.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.93.0"
  }
}
